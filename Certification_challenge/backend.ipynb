    "# Import Tavily search tool\n",
    "from langchain_community.tools import TavilySearchResults\n",
    "\n",
    "# Initialize Tavily search tool\n",
    "tavily_tool = TavilySearchResults(max_results=5)\n",
    "\n",
    "print(\"✅ Tavily search tool initialized successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to search for Tesla-related news and updates\n",
    "def search_tesla_news(query=\"Tesla stock price latest news\"):\n",
    "    \"\"\"Search for Tesla-related news and updates\"\"\"\n",
    "    try:\n",
    "        results = tavily_tool.invoke(query)\n",
    "        print(f\"🔍 Search Results for: {query}\")\n",
    "        print(\"=\" * 60)\n",
    "        \n",
    "        for i, result in enumerate(results, 1):\n",
    "            print(f\"\\n📰 Result {i}:\")\n",
    "            print(f\"Title: {result.get('title', 'N/A')}\")\n",
    "            print(f\"URL: {result.get('url', 'N/A')}\")\n",
    "            print(f\"Content: {result.get('content', 'N/A')[:200]}...\")\n",
    "            \n",
    "        return results\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error searching: {e}\")\n",
    "        return []\n",
    "\n",
    "# Test the search function\n",
    "tesla_news = search_tesla_news()"
   ]
