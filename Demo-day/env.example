# AI Credit Assistant Environment Variables

# Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/credit_assistant
REDIS_URL=redis://localhost:6379/0

# AI/ML Configuration
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=AIE7-CREDIT-RISK-ANALYZER
TAVILY_API_KEY=your-tavily-api-key-here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn-here
ANALYTICS_ID=your-analytics-id-here

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_MONITORING=false
ENABLE_AI_CHAT=true
ENABLE_WHAT_IF_SCENARIOS=true

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
BCRYPT_LOG_ROUNDS=12

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# External APIs
FINANCIAL_API_KEY=your-financial-api-key
CREDIT_BUREAU_API_KEY=your-credit-bureau-api-key

# Development Settings
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Production Settings
# DEBUG=false
# LOG_LEVEL=WARNING
# CORS_ORIGINS=https://yourdomain.com
